################################################################################
# products/lender/secrets — prd
#
# Costs nothing: one IAM role and one IAM policy.
#
# The vault prefixes are not set here: the root derives them from app_env_name,
# and the custody Deny is a literal in main.tf.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "sa-east-1"
product     = "lender"
environment = "prd"

# eks_cluster_name is derived -> lerian-prd-eks

# What helm-internal charts/lender renders with no override. A release that
# overrides namespaceOverride or lender.serviceAccount.name needs the same value
# here, or the :sub condition admits no pod.
service_account = "lender:lender"

# "production", not "prd": the application's ENV_NAME, and the segment of
# tenants/production/*/lender/m2m/ and installation/production/lender/.
app_env_name = "production"

kms_key_arns = []

extra_tags = {
  Owner      = "consignado"
  CostCenter = "consignado-prd"
}
