################################################################################
# products/streaming-hub/valkey — prd
#
# One cache cluster on the smallest usable node, same sizing as stg. The hub
# counts per-tenant rate limiter windows here; it is not a data store, and
# nothing in it survives a restart the hub cannot rebuild by counting again.
#
# Copy to prd.tfvars before use (*.tfvars is gitignored, *.tfvars-example is not).
################################################################################

region      = "us-east-1"
product     = "streaming-hub"
environment = "prd"

mode = "dedicated"

# vpc_name         is derived -> lerian-prd-vpc        (infra-base/vpc)
# eks_cluster_name is derived -> lerian-prd-eks        (infra-base/eks)
# Both carry the "lerian" prefix on purpose: they belong to the infra-base
# FOUNDATION, not to streaming-hub — and not to the shared datastore tier either,
# which carries "shared".

################################################################################
# Ingress
#
# allow_private_subnet_cidr_ingress = true is what makes this stack appliable
# BEFORE infra-base/eks exists: it authorises the Type=private subnet CIDRs,
# which only depend on infra-base/vpc. The EKS node security group is looked up
# on top of that and simply resolves to nothing until the cluster is created —
# check "eks_node_security_group_resolved" warns while that is the case.
#
# allow_vpc_cidr_ingress is the module's VPC CIDR FALLBACK, applied only when
# both allow lists resolve empty. False here so an empty allow list trips the
# module's check "ingress_is_reachable" instead of quietly widening to a CIDR
# that includes the public subnets.
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Engine and sizing — cache.t4g.micro, one cache cluster
#
# Deliberately the same size as stg, and deliberately NOT the gateway's prd
# shape (cache.m7g.large, three clusters, Multi-AZ). That file sizes a cache in
# front of a money path; this one holds three fixed-window counters per tenant.
#
# A single cluster means no automatic failover and no Multi-AZ — both require
# at least two — so a node replacement loses the current windows and the
# limiters start counting again from zero. Accepted: the failure mode is a
# briefly more permissive limiter, not a lost or duplicated event.
#
# Grow it from measurement. multi_az_enabled needs BOTH num_cache_clusters >= 2
# AND automatic_failover_enabled = true; setting one without the others fails
# the apply, not the plan.
################################################################################

engine_version         = "7.2"
parameter_group_family = "valkey7"
port                   = 6379

node_type                  = "cache.t4g.micro"
num_cache_clusters         = 1
automatic_failover_enabled = false
multi_az_enabled           = false
snapshot_retention_limit   = 0

################################################################################
# Security — BOTH SWITCHES TIGHTENED, and there is an ORDER to respect
#
# "preferred" is not weaker TLS, it is OPTIONAL TLS: the listener accepts a
# plaintext client. Combined with no auth token, any pod that can reach this
# security group — every node in the cluster — reads and writes the rate-limiter
# state of a multi-tenant service with no credential at all. That is the posture
# this file refuses to inherit, and the same call the gateway's prd file makes.
#
# Nothing in the hub blocks it: STREAMING_HUB_REDIS_TLS already defaults to true
# and a hardened environment refuses to boot with it false, and
# STREAMING_HUB_REDIS_PASSWORD is a key the chart emits when set.
#
# PRECONDITION, and it is load-bearing: the release must already project
# streaming-hub-prd-valkey/auth-token as STREAMING_HUB_REDIS_PASSWORD before
# this applies. Enforcing the token first takes the control plane's rate
# limiters down — every role mounts /v1, so that is every pod.
################################################################################

transit_encryption_enabled = true
transit_encryption_mode    = "required"
auth_token_enabled         = true

maintenance_window = "mon:00:00-mon:03:00"
apply_immediately  = false

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
}
